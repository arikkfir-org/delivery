{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	log
	log_skip /healthz

	handle /healthz {
		respond "ok" 200
	}

	# Cobranch's module path is cobranch.dev: the go command resolves cobranch.dev/... by fetching it with ?go-get=1
	# and reading the go-import meta tag, which names the repository whose root is the domain.
	@go-get query go-get=1
	handle @go-get {
		header Content-Type "text/html; charset=utf-8"
		respond `<!DOCTYPE html><meta name="go-import" content="cobranch.dev git https://github.com/arikkfir-org/cobranch">` 200
	}

	# The site: static files, no scripts and nothing from other origins. A path that names no file goes to the page.
	handle {
		root * /srv
		header {
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Referrer-Policy strict-origin-when-cross-origin
			X-Content-Type-Options nosniff
			Cache-Control "public, max-age=300"
		}
		file_server
	}

	handle_errors 404 {
		redir * / 302
	}
}
