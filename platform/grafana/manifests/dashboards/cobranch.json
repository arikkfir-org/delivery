{
  "uid": "cobranch-app",
  "title": "Cobranch",
  "description": "cobranch.app: Console page views, API routes, the Git server's throwaway repositories and pack cache (Cobranch's monitoring design).",
  "tags": [
    "cobranch"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Console pages",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Page view time, 95th percentile",
      "description": "How long each Console page took to show, from the navigation's start (load) or the click (route) to the page drawn.",
      "datasource": {
        "type": "stackdriver",
        "uid": "google-cloud-monitoring"
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "displayName": "${__field.labels.cobranch_console_page} ${__field.labels.cobranch_console_navigation}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "google-cloud-monitoring"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "arikkfir",
            "expr": "histogram_quantile(0.95, sum by (le, cobranch_console_page, cobranch_console_navigation) (rate(cobranch_console_page_duration_seconds_bucket{namespace=\"cobranch-app\"}[15m])))",
            "step": "60s"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Git reads per page view",
      "description": "Throwaway repositories the Git server built for one view of each page, on average.",
      "datasource": {
        "type": "stackdriver",
        "uid": "google-cloud-monitoring"
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "displayName": "${__field.labels.cobranch_console_page}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
