      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "google-cloud-monitoring"
          },
          "queryType": "promQL",
          "promQLQuery": {
            "projectName": "arikkfir",
            "expr": "sum by (cobranch_console_page) (rate(cobranch_console_page_git_reads_sum{namespace=\"cobranch-app\"}[15m])) / sum by (cobranch_console_page) (rate(cobranch_console_page_git_reads_count{namespace=\"cobranch-app\"}[15m]))",
            "step": "60s"
          }
        }
      ]
    },
